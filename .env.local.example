# Bu dosya ŞABLONDUR ve commit edilir. Gerçek anahtarlar .env.local'e yazılır (o gizli).
# Kürşad: aşağıdaki değerleri .env.local dosyasına kopyalayıp doldur.

# --- Supabase (Proje Ayarları → API) ---
# Tarayıcıya gider, gizli değil:
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SADECE sunucu tarafı / tohum yükleme scripti. Tarayıcıya ASLA gitmez:
SUPABASE_SERVICE_ROLE_KEY=

# --- Yönetim token'ları (uygulama bunları kullanmaz, sadece CLI/MCP) ---
# Supabase: Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Vercel: Settings → Tokens (info@inneredgemethod.io hesabından)
INNER_EDGE_VERCEL_TOKEN=
